static func generate() -> void:
	_font()
	_lights()
	_particles()


static func _font() -> void:
	var im := L.img(96, 32)
	for ch in GLYPHS:
		var code: int = ch.unicode_at(0) - 32
		var cx := (code % 16) * 6
		var cy := (code / 16) * 8
		var rows: PackedStringArray = GLYPHS[ch].split("|")
		for y in rows.size():
			for x in rows[y].length():
				if rows[y][x] == "#":
					L.px(im, cx + x, cy + y, Color.WHITE)
	L.save(im, "res://assets/ui/font.png")


static func _lights() -> void:
	# banded radial light for the retro look
	var n := 128
	var im := L.img(n, n)
	var soft := L.img(n, n)
	for y in n:
		for x in n:
			var d := Vector2(x + 0.5 - n / 2.0, y + 0.5 - n / 2.0).length() / (n / 2.0)
			var v := clampf(1.0 - d, 0.0, 1.0)
			v = v * v * (3.0 - 2.0 * v)
			var banded := floorf(v * 7.0) / 7.0
			im.set_pixel(x, y, Color(1, 1, 1, banded))
			soft.set_pixel(x, y, Color(1, 1, 1, v))
	L.save(im, "res://assets/ui/light.png")
	L.save(soft, "res://assets/ui/light_soft.png")


static func _particles() -> void:
	var dot := L.img(2, 2)
	dot.fill(Color.WHITE)
	L.save(dot, "res://assets/ui/dot.png")
	var sp := L.img(5, 5)
	L.px(sp, 2, 2, Color.WHITE)
	for p in [Vector2i(1, 2), Vector2i(3, 2), Vector2i(2, 1), Vector2i(2, 3)]:
		L.px(sp, p.x, p.y, Color(1, 1, 1, 0.7))
	for p in [Vector2i(0, 2), Vector2i(4, 2), Vector2i(2, 0), Vector2i(2, 4)]:
		L.px(sp, p.x, p.y, Color(1, 1, 1, 0.3))
	L.save(sp, "res://assets/ui/spark.png")
